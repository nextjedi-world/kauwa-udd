# ── Kauwa Udd env (copy to .env.local; NEVER commit real secrets) ──

# DynamoDB — LOCAL DEV (DynamoDB Local). Comment out for prod.
DYNAMODB_LOCAL_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
DDB_TABLE=kauwa-udd
DDB_AUTH_TABLE=kauwa-udd-auth

# DynamoDB — PRODUCTION (Vercel). Set in Vercel env vars, not here:
#   AWS_ROLE_ARN=arn:aws:iam::<acct>:role/kauwa-udd-vercel   (OIDC, no keys)
#   AWS_REGION=us-east-1
# Provisioning/seed scripts use temp keys (export before running, do not commit):
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...

# Ably (realtime)
ABLY_API_KEY=

# Auth.js
AUTH_SECRET=
# Optional OAuth providers (add later)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
